# Required — fill in before deploying

# Neon Postgres connection string (pooled endpoint recommended)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Vercel Blob read/write token (from your Vercel project → Storage → Blob)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Gemini API key from Google AI Studio
GEMINI_API_KEY=your-gemini-api-key

# Optional model overrides. Both tiers default to Gemini 3.8 Flash.
GEMINI_QUICK_MODEL=gemini-3.8-flash
GEMINI_DEFAULT_MODEL=gemini-3.8-flash

# Shared passcode for field-crew capture/edit access
APP_PASSCODE=change-me-crew

# Separate owner/admin passcode. Must differ from APP_PASSCODE.
# Owner access is required to delete an entire batch.
OWNER_PASSCODE=change-me-owner

# Random 32+ char secret for signing session cookies
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-random-secret-here
